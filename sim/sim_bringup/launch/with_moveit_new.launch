<launch><!--ros controller-->>

    <!-- these are the arguments you can pass this launch file, for example paused:=true -->
    <arg name="paused" default="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" default="true"/>
    <arg name="headless" default="false"/> <!-- Inert - see gazebo_ros_pkgs issue #491 -->
    <arg name="use_rviz" default="$(eval not arg('headless'))"/>
    <arg name="recording" value="false"/>
    <arg name="debug" value="false"/>

    <!-- We resume the logic in empty_world.launch, changing only the name of the world to be launched -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find sim_gazebo)/world/one_brick.world"/>
        <arg name="debug" value="$(arg debug)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)"/>
        <arg name="use_sim_time" value="$(arg use_sim_time)"/>
        <arg name="headless" value="$(arg headless)"/>
    </include>

    <!-- Faster base state updates reduce delay in world-frame PID control. -->
    <arg name="base_pose_update_rate" default="200.0"/>
    <arg name="model" default="$(find xacro)/xacro '$(find sim_description)/urdf/xacro/main.xacro' base_pose_update_rate:=$(arg base_pose_update_rate)" />

    <!-- Run a python script to the send a service call to gazebo_ros to spawn a URDF robot -->
    <!-- Joint-level PID gains for gazebo_ros_control. These must be on the
         parameter server before the model is spawned, because the plugin reads
         them when it loads. Without them the arm's joints are positioned
         kinematically and have no dynamics at all; see the file's header.
         Pass joint_pid_gains:=false for the old behaviour. -->
    <arg name="joint_pid_gains" default="true"/>
    <rosparam file="$(find sim_bringup)/config/gazebo_joint_pid_gains.yaml"
              command="load" if="$(arg joint_pid_gains)"/>

    <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
    args="-urdf -model sim -param robot_description
          -x -1.3
          -y 0.0
          -z 0.0
          -J shoulder_pan_joint  0
          -J shoulder_lift_joint 0
          -J elbow_joint  0
          -J wrist_1_joint 0
          -J wrist_2_joint 0
          -J wrist_3_joint 0" />

    <include file="$(find sim_moveit_config)/launch/sim_bringup_moveit.launch"/>
    <!-- Apply the selected model after MoveIt loads its default description. -->
    <param name="robot_description" command="$(arg model)" />
    <!-- machine_tool_control does not ship with this repository. The include is
         opt-in so that bringup works in a plain checkout; pass
         use_machine_tool:=true once that package is in your workspace. -->
    <arg name="use_machine_tool" default="false"/>
    <include file="$(find machine_tool_control)/launch/machine_tool_control4sim.launch"
             if="$(arg use_machine_tool)"/>

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find sim_description)/rviz/all.rviz"
          required="true" if="$(arg use_rviz)" />

</launch>
