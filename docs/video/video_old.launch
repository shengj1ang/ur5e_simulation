<launch>
  <!-- Headless bringup of the BASELINE workspace (commit 3888830, the last one
       before the control work started) for camera recording.

       The differences from video_new.launch are the baseline itself, not
       choices made here:
         - no gazebo_joint_pid_gains.yaml, because the baseline has no such
           file: its arm joints are positioned kinematically by
           gazebo_ros_control and have no servo dynamics;
         - no base_pose_update_rate argument, because the baseline's main.xacro
           hard-codes the p3d plugin to 50 Hz;
         - no inertia feedforward arguments, because the baseline controller
           has none.
       gantry_velocity_controller.yaml and gantry_disturbance.py were copied in
       so the same base disturbance can be injected; the baseline had no way to
       drive the gantry at all. -->

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find sim_gazebo)/world/one_brick.world"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find sim_description)/urdf/xacro/main.xacro'"/>
  <rosparam file="$(find sim_bringup)/config/gantry_velocity_controller.yaml" command="load"/>

  <node pkg="gazebo_ros" type="spawn_model" name="urdf_spawner"
        args="-urdf -model sim -param robot_description -x -1.3 -y 0 -z 0"/>

  <include file="$(find sim_moveit_config)/launch/sim_gazebo_states.launch"/>
  <include file="$(find sim_moveit_config)/launch/sim_trajectory_controller.launch"/>
  <include file="$(find sim_pid_control)/launch/pid_controller.launch"/>
</launch>
